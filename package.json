{
  "name": "techvision-backup",
  "version": "1.0.0",
  "description": "TechVision Backup MVP - Electron App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node src/test/run-tests.js",
    "build": "electron-builder"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "nodemailer": "^6.9.14",
    "yauzl": "^3.4.0",
    "archiver-zip-encrypted": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.techvision.backup",
    "productName": "TechVision Backup",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!**/*.map"
    ]
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
