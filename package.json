{
  "name": "techvision-backup",
  "version": "1.0.0",
  "description": "TechVision Backup MVP - Electron App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node src/test/run-tests.js",
    "test:job-delete": "node --test src/test/job-delete-regression.js",
    "build": "electron-builder",
    "prebuild": "node scripts/prepare-protected-build.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bytenode": "^2.1.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "nodemailer": "^6.9.14",
    "selfsigned": "^3.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.18.0",
    "javascript-obfuscator": "^4.1.0"
  },
  "build": {
    "appId": "com.techvision.backup",
    "productName": "TechVision Backup",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false
    },
    "files": [
      {
        "from": "build-protected/src",
        "to": "src"
      },
      "package.json",
      "node_modules/**/*",
      "!**/*.map"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
